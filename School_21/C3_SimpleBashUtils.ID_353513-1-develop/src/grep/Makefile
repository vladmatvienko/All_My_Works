# Определение компилятора и флагов компиляции
CC = gcc  # Использование компилятора GCC
# Флаги компиляции:
CFLAGS = -Wall -Wextra -Werror -std=c11 -pedantic -D_GNU_SOURCE
# -Wall: включить все стандартные предупреждения
# -Wextra: включить дополнительные предупреждения
# -Werror: трактовать предупреждения как ошибки (останавливать компиляцию)
# -std=c11: использовать стандарт C11
# -pedantic: строгое соответствие стандарту ANSI
# -D_GNU_SOURCE: определить макрос для включения GNU-расширений

TARGET = s21_grep  # Имя конечного исполняемого файла
SRC = s21_grep.c   # Список исходных файлов (только один файл)
OBJ = $(SRC:.c=.o) # Генерация списка объектных файлов: заменяем .c на .o

# Цель по умолчанию - собирает основную цель $(TARGET)
all: $(TARGET)

# Сборка основного целевого исполняемого файла
# Линковка: компилятор + флаги + выходной файл + объектные файлы
$(TARGET): $(OBJ)
	$(CC) $(CFLAGS) -o $@ $^

# Шаблонное правило для компиляции .c файлов в .o файлы
# Компиляция: компилятор + флаги + флаг компиляции (-c) + входной файл + выходной файл
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Запуск тестов
test: $(TARGET)
	chmod +x test_grep.sh
	./test_grep.sh

# Цель для очистки сгенерированных файлов сборки
clean:
	rm -f $(OBJ) $(TARGET)

# Полная пересборка с очисткой
rebuild: clean all  

# Проверка утечек памяти с valgrind
valgrind: $(TARGET)  # Также зависит от актуальной сборки
	chmod +x valgrind_test.sh
	./valgrind_test.sh

# Объявление псевдоцелей (не создают файлов с такими именами)
.PHONY: all clean rebuild test valgrind
# Это важно чтобы make не искал файлы с именами all, clean и т.д.